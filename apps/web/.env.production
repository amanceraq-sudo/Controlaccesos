# Por defecto: API serverless en el mismo dominio Vercel (sin Socket.IO).
# Cuando tengas el API en Render, sobrescribe estas vars en el dashboard de Vercel:
# VITE_API_URL=https://TU-SERVICIO.onrender.com/api
# VITE_SOCKET_URL=https://TU-SERVICIO.onrender.com
# VITE_ENABLE_SOCKET=true
# VITE_POLL_MS=0
VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_ENABLE_SOCKET=false
VITE_POLL_MS=3000
