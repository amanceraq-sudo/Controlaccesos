# Backend (también configurar estas variables en Vercel → Project → Settings → Environment Variables)

PORT=4000
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/control_accesos?retryWrites=true&w=majority
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_seguro
JWT_EXPIRES_IN=7d

# Orígenes web permitidos. Usa * para permitir cualquiera (recomendado con app móvil + Vercel)
# En local puedes usar: http://localhost:5173
CORS_ORIGIN=*

SEED_ADMIN_EMAIL=admin@accesos.local
SEED_ADMIN_PASSWORD=Admin123!

# Solo para desarrollo local con Node persistente (en Vercel Socket.IO no aplica)
ENABLE_SOCKET=true

# Frontend (opcional en Vercel: por defecto usa /api del mismo dominio)
# VITE_API_URL=/api
# VITE_SOCKET_URL=
# VITE_ENABLE_SOCKET=false
